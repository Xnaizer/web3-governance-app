    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "20.16.10",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^11.0.0",
    "pino-pretty": "^13.1.3",
