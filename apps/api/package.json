    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.2",
